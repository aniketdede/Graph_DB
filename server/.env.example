# CognoDB connection — copy to .env and fill in (never commit .env)
# The URI comes from the CognoDB Cloud console (one-time password shown at creation)
COGNODB_URI=bolt+s://<instance-id>.<region>.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=<your-generated-password>
PORT=4000
# DEMO_MODE=true   # force in-memory demo data (no database needed)
